# Backend API (PH-6 Housing & Roommate backend). Server-only - never exposed to the browser.
# Local backend (macOS uses port 5000 for AirPlay, so run the API on 5050):
API_BASE_URL=http://localhost:5050/api/v1

# Public URL of this frontend (used for metadata / Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# One-click demo login accounts (server-only).
DEMO_ADMIN_EMAIL=admin@housing.local
DEMO_ADMIN_PASSWORD=
DEMO_OWNER_EMAIL=owner.demo@nestmate.app
DEMO_OWNER_PASSWORD=OwnerDemo@2026
DEMO_TENANT_EMAIL=tenant.demo@nestmate.app
DEMO_TENANT_PASSWORD=TenantDemo@2026
